APP_NAME="MTD Art"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ro
APP_FALLBACK_LOCALE=ro
APP_FAKER_LOCALE=ro_RO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Local HTTP development must keep this false. ProductionSecurityServiceProvider requires true in production.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@mtdart.ro"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Marketing tracking stays disabled until consent + GTM are tested end-to-end.
MARKETING_TRACKING_ENABLED=false
GTM_CONTAINER_ID=
GA4_MEASUREMENT_ID=
ANALYTICS_PROPERTY_ID=
ANALYTICS_CREDENTIALS_PATH=
ANALYTICS_CACHE_STORE=file
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0
# Staging/Test Events only. Keep empty in production.
META_CAPI_TEST_EVENT_CODE=
TIKTOK_PIXEL_ID=

# Complete these values before running the legal-pages migration in production.
SHOP_BRAND_NAME="MTD Art"
SHOP_LEGAL_BUSINESS_NAME=
SHOP_LEGAL_TAX_ID=
SHOP_LEGAL_TRADE_REGISTER=
SHOP_LEGAL_ADDRESS=
SHOP_LEGAL_EMAIL="contact@mtdart.ro"
SHOP_LEGAL_PHONE=
SHOP_LEGAL_IBAN=
SHOP_LEGAL_BANK=
SHOP_TERMS_VERSION="2026-08-06"
SHOP_CHECKOUT_RESERVATION_MINUTES=31
# Delivery charged once per order, in RON. Use 0 for free delivery.
SHOP_SHIPPING_COST=0
