# Hardened production template. Never commit the real .env file or real credentials.
APP_NAME="MTD Art"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mtdart.ro

APP_LOCALE=ro
APP_FALLBACK_LOCALE=ro
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mtdart_db
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

# Admin MFA: active work uses a sliding idle window, with a hard maximum lifetime.
ADMIN_MFA_CODE_SECONDS=600
ADMIN_MFA_IDLE_SECONDS=7200
ADMIN_MFA_ABSOLUTE_SECONDS=43200
ADMIN_MFA_SEND_ATTEMPTS=3
ADMIN_MFA_VERIFY_ATTEMPTS=5

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Outgoing transactional mail: Brevo SMTP relay.
# Use the Brevo SMTP login + SMTP key here (NOT the Brevo API key).
# Port 587 uses STARTTLS automatically; leave MAIL_SCHEME unset/null.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@mtdart.ro"
MAIL_FROM_NAME="${APP_NAME}"

# Incoming mail for contact@mtdart.ro is handled outside Laravel:
# ImprovMX MX records -> your existing Gmail inbox.
# Keep the public/legal contact address on the domain, not the private Gmail address.

VITE_APP_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

SHOP_BRAND_NAME="MTD Art"
SHOP_LEGAL_BUSINESS_NAME=
SHOP_LEGAL_TAX_ID=
SHOP_LEGAL_TRADE_REGISTER=
SHOP_LEGAL_ADDRESS=
SHOP_LEGAL_EMAIL="contact@mtdart.ro"
SHOP_LEGAL_PHONE=
SHOP_LEGAL_IBAN=
SHOP_LEGAL_BANK=
SHOP_TERMS_VERSION="2026-08-06"
SHOP_CHECKOUT_RESERVATION_MINUTES=31
SHOP_SHIPPING_COST=0
