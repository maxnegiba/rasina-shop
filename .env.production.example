# Hardened production template. Never commit the real .env file or real credentials.
APP_NAME="MTD Art"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mtdart.ro

APP_LOCALE=ro
APP_FALLBACK_LOCALE=ro
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mtdart_db
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Transactional email uses Brevo's HTTPS API, not a local/IONOS mailbox and not SMTP.
# BREVO_API_KEY must stay only in the real production .env and must never be committed.
MAIL_MAILER=log
BREVO_API_KEY=
BREVO_API_ENDPOINT=https://api.brevo.com/v3/smtp/email
BREVO_SENDER_EMAIL="contact@mtdart.ro"
BREVO_SENDER_NAME="${APP_NAME}"
# Point Reply-To at a real Gmail/Yahoo inbox that you already use.
BREVO_REPLY_TO_EMAIL=
BREVO_REPLY_TO_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

SHOP_BRAND_NAME="MTD Art"
SHOP_LEGAL_BUSINESS_NAME=
SHOP_LEGAL_TAX_ID=
SHOP_LEGAL_TRADE_REGISTER=
SHOP_LEGAL_ADDRESS=
SHOP_LEGAL_EMAIL="contact@mtdart.ro"
SHOP_LEGAL_PHONE=
SHOP_LEGAL_IBAN=
SHOP_LEGAL_BANK=
SHOP_TERMS_VERSION="2026-08-06"
SHOP_CHECKOUT_RESERVATION_MINUTES=31
SHOP_SHIPPING_COST=0
